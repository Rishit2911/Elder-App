// SeniorCare Platform – Database Markup Language (DBML)
// Compatible with dbdiagram.io
// Phase 1 Deliverable | Role: Person 2 (Database Designer & API Architect)

Project SeniorCare {
  database_type: 'PostgreSQL'
  Note: 'AI-Powered Elderly Healthcare & Caregiving Platform'
}

// -------------------------------------------------------------
// MODULE A: USER MANAGEMENT & PROFILES
// -------------------------------------------------------------

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  phone_number varchar(20) [unique, not null]
  email varchar(255) [unique]
  hashed_password varchar(255)
  role varchar(30) [not null, note: 'senior, family, caregiver, doctor, admin']
  is_active boolean [not null, default: true]
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    phone_number [name: 'idx_users_phone']
    role [name: 'idx_users_role']
  }
}

Table senior_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  full_name varchar(150) [not null]
  preferred_name varchar(100)
  date_of_birth date [not null]
  gender varchar(20) [not null]
  blood_group varchar(5)
  address text [not null]
  city varchar(100) [not null]
  postal_code varchar(20) [not null]
  latitude decimal(10, 8)
  longitude decimal(11, 8)
  primary_language varchar(20) [not null, default: 'hi']
  emergency_notes text
  profile_picture_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (city, latitude, longitude) [name: 'idx_seniors_city_geo']
  }
}

Table family_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  full_name varchar(150) [not null]
  alternate_phone varchar(20)
  relationship_description varchar(100)
  notification_preferences_json jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table caregiver_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  full_name varchar(150) [not null]
  gender varchar(20) [not null]
  bio text
  experience_years integer [not null, default: 0]
  hourly_rate decimal(10, 2) [not null]
  daily_rate decimal(10, 2)
  verification_status varchar(30) [not null, default: 'pending', note: 'pending, verified, rejected, suspended']
  police_clearance_verified boolean [not null, default: false]
  medical_training_verified boolean [not null, default: false]
  rating_average decimal(3, 2) [not null, default: 0.00]
  total_reviews integer [not null, default: 0]
  is_available_for_hire boolean [not null, default: true]
  service_city varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (service_city, verification_status, is_available_for_hire) [name: 'idx_caregivers_city_verified']
  }
}

Table doctor_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  full_name varchar(150) [not null]
  specialization varchar(100) [not null]
  medical_license_number varchar(100) [unique, not null]
  qualifications varchar(200) [not null]
  hospital_affiliation varchar(200)
  consultation_fee decimal(10, 2) [not null]
  is_verified boolean [not null, default: false]
  rating_average decimal(3, 2) [not null, default: 0.00]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE B: FAMILY CONNECTIONS & REBAC PERMISSIONS
// -------------------------------------------------------------

Table family_relationships {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  family_user_id uuid [not null]
  relation_type varchar(50) [not null, note: 'son, daughter, spouse, grandchild, guardian']
  is_primary_caregiver_contact boolean [not null, default: false]
  is_emergency_contact boolean [not null, default: true]
  status varchar(30) [not null, default: 'active', note: 'active, paused, revoked']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (senior_id, family_user_id) [unique, name: 'uq_senior_family_link']
    senior_id [name: 'idx_rel_senior']
    family_user_id [name: 'idx_rel_family']
  }
}

Table family_invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  inviter_user_id uuid [not null]
  invitee_phone varchar(20) [not null]
  invitee_email varchar(255)
  invitation_code varchar(64) [unique, not null]
  relation_proposed varchar(50) [not null]
  status varchar(30) [not null, default: 'pending', note: 'pending, accepted, rejected, expired, cancelled']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    invitation_code [name: 'idx_invitations_code']
    (invitee_phone, status) [name: 'idx_invitations_status']
  }
}

Table access_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  relationship_id uuid [not null]
  permission_module varchar(50) [not null, note: 'health_records, medicines, live_location, caregiver_bookings, doctor_consultations, financial_billing']
  access_level varchar(20) [not null, note: 'none, view_only, full_management']
  granted_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (relationship_id, permission_module) [unique, name: 'uq_rel_permission_module']
  }
}

// -------------------------------------------------------------
// MODULE C: AUTHENTICATION, SESSIONS & BIOMETRICS
// -------------------------------------------------------------

Table devices {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  device_uuid varchar(100) [not null]
  fcm_token text
  platform varchar(20) [not null, note: 'android, ios, web']
  device_model varchar(100)
  app_version varchar(20)
  last_active_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, device_uuid) [unique, name: 'uq_user_device']
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  device_id uuid [not null]
  token_hash varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  is_revoked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (token_hash, is_revoked) [name: 'idx_refresh_lookup']
  }
}

Table login_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  auth_method varchar(30) [not null, note: 'password, face_recognition, otp_sms']
  ip_address varchar(45)
  user_agent text
  is_successful boolean [not null]
  failure_reason varchar(100)
  created_at timestamptz [not null, default: `now()`]
}

Table face_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  encrypted_embedding bytea [not null]
  encryption_iv bytea [not null]
  encryption_tag bytea [not null]
  model_version varchar(50) [not null, default: 'arcface_r50_v1']
  quality_score decimal(4, 3) [not null]
  liveness_score decimal(4, 3) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE D: HEALTHCARE & MEDICINE SCHEDULES
// -------------------------------------------------------------

Table health_records {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  title varchar(200) [not null]
  record_type varchar(50) [not null, note: 'vitals, lab_test, doctor_summary, discharge_summary, vaccination']
  recorded_at timestamptz [not null]
  recorded_by_user_id uuid [not null]
  vital_bp_systolic integer
  vital_bp_diastolic integer
  vital_heart_rate integer
  vital_blood_glucose decimal(5, 1)
  vital_oxygen_saturation decimal(4, 1)
  vital_temperature decimal(4, 1)
  notes text
  document_s3_key varchar(500)
  document_file_hash varchar(64)
  document_mime_type varchar(100)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (senior_id, recorded_at) [name: 'idx_health_senior_date']
  }
}

Table prescriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  prescribing_doctor_id uuid
  prescribing_doctor_name varchar(150)
  diagnosis text
  issued_date date [not null]
  valid_until date
  document_s3_key varchar(500)
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table medicines {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  prescription_id uuid
  name varchar(150) [not null]
  dosage_strength varchar(50) [not null]
  form varchar(30) [not null, note: 'tablet, capsule, syrup, injection, drops']
  meal_relation varchar(30) [not null, note: 'before_meal, after_meal, with_meal, empty_stomach']
  color_code varchar(10)
  start_date date [not null]
  end_date date
  instructions text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table medicine_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  medicine_id uuid [not null]
  time_of_day time [not null]
  days_of_week integer[]
  dose_quantity decimal(3, 1) [not null, default: 1.0]
  reminder_lead_minutes integer [not null, default: 10]

  indexes {
    time_of_day [name: 'idx_schedules_time']
  }
}

Table medicine_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  schedule_id uuid [not null]
  senior_id uuid [not null]
  scheduled_timestamp timestamptz [not null]
  status varchar(30) [not null, note: 'taken, missed, skipped, snoozed']
  logged_at timestamptz [not null, default: `now()`]
  acknowledged_by_user_id uuid [not null]
  notes text

  indexes {
    (schedule_id, scheduled_timestamp) [unique, name: 'uq_schedule_dose']
    (senior_id, status, scheduled_timestamp) [name: 'idx_medlogs_senior_status']
  }
}

// -------------------------------------------------------------
// MODULE E: CAREGIVER SERVICES & BOOKINGS
// -------------------------------------------------------------

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(150) [not null]
  category varchar(50) [not null, note: 'daily_companion, nursing_care, physiotherapy, mobility_support']
  description text [not null]
  base_hourly_rate decimal(10, 2) [not null]
  icon_key varchar(50)
  is_active boolean [not null, default: true]
}

Table caregiver_qualifications {
  id uuid [pk, default: `gen_random_uuid()`]
  caregiver_id uuid [not null]
  qualification_title varchar(200) [not null]
  institution varchar(200) [not null]
  year_completed integer [not null]
  certificate_s3_key varchar(500)
  is_verified boolean [not null, default: false]
}

Table caregiver_verification_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  caregiver_id uuid [not null]
  document_type varchar(50) [not null, note: 'aadhaar, pan_card, police_verification, nursing_council_cert']
  document_number varchar(100) [not null]
  document_s3_key varchar(500) [not null]
  verification_status varchar(30) [not null, default: 'pending']
  reviewed_by_admin_id uuid
  rejection_reason text
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table caregiver_availability {
  id uuid [pk, default: `gen_random_uuid()`]
  caregiver_id uuid [not null]
  day_of_week integer [not null, note: '1 to 7']
  start_time time [not null]
  end_time time [not null]
  is_active boolean [not null, default: true]
}

Table bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  booked_by_user_id uuid [not null]
  caregiver_id uuid [not null]
  service_id uuid [not null]
  booking_type varchar(30) [not null, note: 'hourly, daily, weekly, monthly']
  start_datetime timestamptz [not null]
  end_datetime timestamptz [not null]
  special_instructions text
  total_hours decimal(5, 2) [not null]
  hourly_rate_agreed decimal(10, 2) [not null]
  total_amount decimal(10, 2) [not null]
  payment_status varchar(30) [not null, default: 'unpaid', note: 'unpaid, escrow_held, paid, refunded']
  status varchar(30) [not null, default: 'requested', note: 'requested, confirmed, in_progress, completed, cancelled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    senior_id [name: 'idx_bookings_senior']
    (caregiver_id, status) [name: 'idx_bookings_caregiver']
  }
}

Table booking_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null]
  previous_status varchar(30)
  new_status varchar(30) [not null]
  changed_by_user_id uuid [not null]
  reason_or_notes text
  created_at timestamptz [not null, default: `now()`]
}

Table caregiver_visit_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null]
  caregiver_id uuid [not null]
  senior_id uuid [not null]
  check_in_time timestamptz [not null]
  check_out_time timestamptz [not null]
  check_in_latitude decimal(10, 8)
  check_in_longitude decimal(11, 8)
  activities_performed jsonb [not null]
  vital_blood_pressure varchar(20)
  vital_pulse integer
  vital_sugar decimal(5, 1)
  mood_observation varchar(50) [not null]
  caregiver_notes text [not null]
  report_photo_s3_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE F: MEDICAL CONSULTATIONS & LAB BOOKINGS
// -------------------------------------------------------------

Table doctor_appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  doctor_id uuid [not null]
  booked_by_user_id uuid [not null]
  scheduled_time timestamptz [not null]
  appointment_type varchar(30) [not null, note: 'video_consult, clinic_visit, home_visit']
  status varchar(30) [not null, default: 'scheduled', note: 'scheduled, in_progress, completed, cancelled, no_show']
  reason_for_consultation text [not null]
  video_room_id varchar(100)
  doctor_notes text
  fee_amount decimal(10, 2) [not null]
  payment_status varchar(30) [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table lab_bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  booked_by_user_id uuid [not null]
  lab_provider_name varchar(150) [not null]
  test_package_name varchar(200) [not null]
  scheduled_date date [not null]
  collection_type varchar(30) [not null, note: 'home_sample_collection, diagnostic_center_visit']
  status varchar(30) [not null, default: 'booked']
  total_cost decimal(10, 2) [not null]
  report_s3_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE G: EMERGENCY SOS & CONTACTS
// -------------------------------------------------------------

Table emergency_contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  contact_name varchar(150) [not null]
  phone_number varchar(20) [not null]
  relationship varchar(50) [not null]
  priority_order integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (senior_id, priority_order) [name: 'idx_emergency_senior_priority']
  }
}

Table sos_events {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  triggered_at timestamptz [not null, default: `now()`]
  trigger_source varchar(30) [not null, note: 'in_app_button, voice_assistant_keyword, fall_detection_sensor']
  latitude decimal(10, 8) [not null]
  longitude decimal(11, 8) [not null]
  approximate_address text
  battery_level_percent integer
  status varchar(30) [not null, default: 'active', note: 'active, acknowledged, resolved, false_alarm']
  acknowledged_at timestamptz
  resolved_at timestamptz
  resolved_by_user_id uuid
  resolution_notes text
  broadcast_payload jsonb [default: '{}']

  indexes {
    (senior_id, status) [name: 'idx_sos_active']
  }
}

// -------------------------------------------------------------
// MODULE H: FAMILY COMMUNICATION & UPDATES
// -------------------------------------------------------------

Table family_updates {
  id uuid [pk, default: `gen_random_uuid()`]
  senior_id uuid [not null]
  author_user_id uuid [not null]
  caption text [not null]
  update_type varchar(30) [not null, default: 'photo']
  is_pinned boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table update_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  update_id uuid [not null]
  attachment_s3_key varchar(500) [not null]
  file_mime_type varchar(50) [not null]
  file_size_bytes integer [not null]
  created_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE I: PAYMENTS & SUBSCRIPTIONS
// -------------------------------------------------------------

Table subscription_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  plan_code varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text [not null]
  price_inr decimal(10, 2) [not null]
  billing_interval varchar(20) [not null, note: 'monthly, quarterly, yearly']
  features_json jsonb [not null]
  is_active boolean [not null, default: true]
}

Table subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  plan_id uuid [not null]
  status varchar(30) [not null, note: 'active, past_due, cancelled, expired']
  start_date date [not null]
  end_date date [not null]
  auto_renew boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  booking_id uuid
  subscription_id uuid
  appointment_id uuid
  amount decimal(10, 2) [not null]
  currency varchar(5) [not null, default: 'INR']
  gateway_provider varchar(30) [not null, note: 'razorpay, stripe, cash_on_service']
  gateway_order_id varchar(100)
  gateway_payment_id varchar(100)
  status varchar(30) [not null, default: 'created', note: 'created, captured, failed, refunded']
  receipt_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------------
// MODULE J: NOTIFICATIONS & PREFERENCES
// -------------------------------------------------------------

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  title varchar(200) [not null]
  body text [not null]
  category varchar(50) [not null, note: 'medicine_reminder, sos_emergency, caregiver_update, family_message, appointment']
  deep_link_screen varchar(100)
  reference_entity_id uuid
  is_read boolean [not null, default: false]
  sent_at timestamptz [not null, default: `now()`]
  read_at timestamptz

  indexes {
    (user_id, is_read, sent_at) [name: 'idx_notifs_user_read']
  }
}

Table notification_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  push_enabled boolean [not null, default: true]
  sms_enabled boolean [not null, default: true]
  whatsapp_enabled boolean [not null, default: true]
  email_enabled boolean [not null, default: false]
  quiet_hours_enabled boolean [not null, default: false]
  quiet_hours_start time
  quiet_hours_end time
}

// -------------------------------------------------------------
// MODULE K: REVIEWS & AUDIT LOGS
// -------------------------------------------------------------

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  reviewer_user_id uuid [not null]
  target_type varchar(30) [not null, note: 'caregiver, doctor']
  target_id uuid [not null]
  booking_id uuid
  rating integer [not null, note: '1 to 5']
  review_text text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (target_type, target_id) [name: 'idx_reviews_target']
  }
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid [not null]
  target_entity_type varchar(50) [not null]
  target_entity_id uuid [not null]
  action varchar(50) [not null, note: 'CREATE, READ, UPDATE, REVOKE, DELETE']
  ip_address varchar(45)
  details_json jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_user_id, target_entity_type, created_at) [name: 'idx_audit_actor_target']
  }
}

// -------------------------------------------------------------
// FOREIGN KEY REFERENCES
// -------------------------------------------------------------

Ref: senior_profiles.user_id > users.id [delete: cascade]
Ref: family_profiles.user_id > users.id [delete: cascade]
Ref: caregiver_profiles.user_id > users.id [delete: cascade]
Ref: doctor_profiles.user_id > users.id [delete: cascade]

Ref: devices.user_id > users.id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: refresh_tokens.device_id > devices.id [delete: cascade]
Ref: login_sessions.user_id > users.id [delete: cascade]
Ref: face_profiles.user_id > users.id [delete: cascade]

Ref: family_relationships.senior_id > senior_profiles.id [delete: cascade]
Ref: family_relationships.family_user_id > users.id [delete: cascade]
Ref: family_invitations.senior_id > senior_profiles.id [delete: cascade]
Ref: family_invitations.inviter_user_id > users.id [delete: cascade]
Ref: access_permissions.relationship_id > family_relationships.id [delete: cascade]

Ref: health_records.senior_id > senior_profiles.id [delete: cascade]
Ref: health_records.recorded_by_user_id > users.id [delete: restrict]
Ref: prescriptions.senior_id > senior_profiles.id [delete: cascade]
Ref: prescriptions.prescribing_doctor_id > doctor_profiles.id [delete: set null]
Ref: medicines.senior_id > senior_profiles.id [delete: cascade]
Ref: medicines.prescription_id > prescriptions.id [delete: set null]
Ref: medicine_schedules.medicine_id > medicines.id [delete: cascade]
Ref: medicine_logs.schedule_id > medicine_schedules.id [delete: cascade]
Ref: medicine_logs.senior_id > senior_profiles.id [delete: cascade]
Ref: medicine_logs.acknowledged_by_user_id > users.id [delete: restrict]

Ref: caregiver_qualifications.caregiver_id > caregiver_profiles.id [delete: cascade]
Ref: caregiver_verification_documents.caregiver_id > caregiver_profiles.id [delete: cascade]
Ref: caregiver_verification_documents.reviewed_by_admin_id > users.id [delete: set null]
Ref: caregiver_availability.caregiver_id > caregiver_profiles.id [delete: cascade]
Ref: bookings.senior_id > senior_profiles.id [delete: restrict]
Ref: bookings.booked_by_user_id > users.id [delete: restrict]
