# ==============================================================================
# SeniorCare Backend – Environment Configuration Template
# Duplicate this file to .env and provide your deployment secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="SeniorCare API"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000"

# Secret Keys for JWT & Encryption (Generate via `openssl rand -hex 32`)
SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-string"
REFRESH_SECRET_KEY="replace-this-with-another-secure-random-64-character-hex-string"
BIOMETRIC_MASTER_KEY="replace-this-with-a-32-byte-hex-key-for-aes-256-gcm"

# JWT Expiration Configurations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Connection
POSTGRES_USER=seniorcare_admin
POSTGRES_PASSWORD=seniorcare_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seniorcare_db
DATABASE_URL="postgresql+asyncpg://seniorcare_admin:seniorcare_secure_pass@localhost:5432/seniorcare_db"

# Redis Cache & Celery Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# MinIO / AWS S3 Private Medical Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="seniorcare-private"
S3_REGION="ap-south-1"

# External Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=""
FIREBASE_CREDENTIALS_PATH="/secrets/firebase-service-account.json"

# External Telephony & Emergency SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

