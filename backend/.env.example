# ==============================================================================
# SeniorCare Backend – Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="SeniorCare API"
API_V1_PREFIX="/api/v1"
DEBUG=true

HOST=0.0.0.0
PORT=8000

# CORS – add your Flutter dev port if needed
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000,http://10.0.2.2:8000"

# JWT Secret Keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="replace-with-secure-random-64-char-hex"
REFRESH_SECRET_KEY="replace-with-another-secure-random-64-char-hex"
BIOMETRIC_MASTER_KEY="replace-with-32-byte-hex-for-aes-256-gcm"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database (replace with your actual MySQL credentials)
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=elderly_seva_db

# Redis (optional – required only for Celery background tasks)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# MinIO / S3 (optional – for medical document storage)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="seniorcare-private"
S3_REGION="ap-south-1"

# Firebase (optional – for push notifications)
FCM_SERVER_KEY=""
FIREBASE_CREDENTIALS_PATH=""

# Twilio (optional – for emergency SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Razorpay (optional – for payment processing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
